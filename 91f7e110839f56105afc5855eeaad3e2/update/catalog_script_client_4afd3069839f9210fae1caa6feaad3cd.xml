        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    // Define the regex for BRL currency validation
    var brlRegex = /^[0-9]{1,3}(\.[0-9]{3})*,[0-9]{2}$/;

    // Validate the newValue directly
    if (!brlRegex.test(newValue)) {
        // If not matched, display an error message on the 'amount_in_brl' field
        g_form.showFieldMsg('amount_in_brl', 'Please enter the amount in the correct format (e.g., 1.234,56 or 476,02)', 'error');
    } else {
        // Clear the field message if the value matches the pattern
        g_form.hideFieldMsg('amount_in_brl');
    }
}
]]></script>
